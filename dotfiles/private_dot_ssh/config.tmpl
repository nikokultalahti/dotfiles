{{ if eq .chezmoi.os "darwin" }}
Host *
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
    IdentitiesOnly yes
{{ end }}

Host github.com
    HostName github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/github-auth.pub

{{ if not .work }}
{{ (bitwarden "item" "dotfiles-sshconfig-personal").notes }}
{{ end }}

{{ if .work }}
{{ (bitwarden "item" "dotfiles-sshconfig-work").notes }}
{{ end }}