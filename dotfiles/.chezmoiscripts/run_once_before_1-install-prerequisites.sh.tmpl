#!/bin/sh
# Installs mise and the password manager CLI needed by later steps.

set -eu

install_mise() {
    command -v mise >/dev/null 2>&1 && return 0
    curl -fsSL https://mise.run | sh
    export PATH="$HOME/.local/bin:$PATH"
    CURRENT_SHELL="$(basename "${SHELL:-bash}")"
    eval "$("$HOME/.local/bin/mise" activate "$CURRENT_SHELL" 2>/dev/null || "$HOME/.local/bin/mise" activate bash)"
}

install_bitwarden_cli() {
    command -v bw >/dev/null 2>&1 || "$HOME/.local/bin/mise" use -g bitwarden
    if ! bw login --check >/dev/null 2>&1; then
        bw config server https://vault.bitwarden.eu
        bw login --apikey
    fi
}

{{ if .work -}}
install_dashlane_cli() {
    command -v dcli >/dev/null 2>&1 && return 0
    "$HOME/.local/bin/mise" bootstrap packages use -g brew:dashlane/tap/dashlane-cli
}
{{ end -}}

install_mise
export PATH="$HOME/.local/share/mise/shims:$PATH"

install_bitwarden_cli
{{ if .work -}}
install_dashlane_cli
{{ end -}}
