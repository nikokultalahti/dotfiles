#!/bin/sh
# Installs all tools and apps via mise, then VS Code extensions. Deliberately
# has no OS-specific branching: mise itself is cross-platform, and
# .chezmoidata/extensions.toml is scoped by role (common/personal/work), not
# OS, matching dot_config/mise/config.toml.tmpl.
#
# Re-runs whenever the underlying package/tool/extension data changes (see the
# manifest hash below).
#
# Manifest hash (do not remove, forces a re-run on data changes):
# {{ (dict "mise" .mise "extensions" .extensions | toJson) | sha256sum }}

set -e

echo "[-] Installing tools and apps via mise [-]"
mise install
mise bootstrap packages apply --yes

echo "[-] Installing VS Code extensions [-]"
{{ range .extensions.vscode.common.extensions -}}
if ! code --list-extensions | grep -qF {{ . | quote }}; then
    echo "Installing extension {{ . }}..."
    code --force --install-extension {{ . | quote }}
else
    echo "Extension already installed: {{ . }}"
fi
{{ end -}}

{{ if .work -}}
{{ range .extensions.vscode.work.extensions -}}
if ! code --list-extensions | grep -qF {{ . | quote }}; then
    echo "Installing extension {{ . }}..."
    code --force --install-extension {{ . | quote }}
else
    echo "Extension already installed: {{ . }}"
fi
{{ end -}}
{{ else -}}
{{ range .extensions.vscode.personal.extensions -}}
if ! code --list-extensions | grep -qF {{ . | quote }}; then
    echo "Installing extension {{ . }}..."
    code --force --install-extension {{ . | quote }}
else
    echo "Extension already installed: {{ . }}"
fi
{{ end -}}
{{ end -}}

echo "[-] Package installation completed [-]"
