
#
# .zshrc is sourced in interactive shells.
# It should contain commands to set up aliases,
# functions, options, key bindings, etc.
#

autoload -U compinit
compinit

# Allow tab completion in the middle of a word
setopt COMPLETE_IN_WORD

{{ if eq .chezmoi.os "darwin" }}
# mise's brew/brew-cask backends install formulae/casks without Homebrew
# itself, but still lay them out under the standard Homebrew prefix.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
{{ end }}

# Activate mise (installs/manages all tools and apps)
eval "$(mise activate zsh)"

# Set SSH AUTH SOCK for Bitwarden
{{ if eq .chezmoi.os "darwin" }}
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
{{ else }}
export SSH_AUTH_SOCK="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
{{ end }}

# Initialize atuin, Starship, Zoxide, tv
eval "$(atuin init zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(tv init zsh)"

# source zsh autosuggestions and syntax highlightning
{{ if eq .chezmoi.os "darwin" }}
if suggestions_prefix="$(mise bootstrap packages where brew:zsh-autosuggestions 2>/dev/null)"; then
    source "$suggestions_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if highlighting_prefix="$(mise bootstrap packages where brew:zsh-syntax-highlighting 2>/dev/null)"; then
    source "$highlighting_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset suggestions_prefix highlighting_prefix
{{ else }}
# Installed via rpm-ostree host layering (see docs/silverblue-install-guidef.md),
# not mise/Homebrew.
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null || true
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null || true
{{ end }}

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Add Carapace
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)

{{ if eq .chezmoi.os "darwin" }}
# Add gcloud git-credential.helper to PATH
# (mise's brew-cask backend has no `where` lookup for casks yet, so this
# assumes the standard Homebrew Caskroom layout under /opt/homebrew)
if [ -f "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc" ]; then
    source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"
fi

# Fixes Ghostty backspace bug over gcloud compute ssh & IAP tunnels
gcloud() {
    # Detects if 'compute ssh' is invoked anywhere in the command arguments
    if [[ "$*" == *"compute ssh"* ]]; then
        TERM=xterm-256color command gcloud "$@"
    else
        command gcloud "$@"
    fi
}
{{ end }}

# Fixes SSH Remote issues with ghosttty
if [[ -n "$SSH_CONNECTION" ]]; then
    export TERM=xterm-256color
fi

# ALIASES

# eza for ls
if command -v eza >/dev/null 2>&1; then
    alias ll='eza -al --icons=auto --group-directories-first'
    alias l.='eza -d .*'
    alias ls='eza'
    alias l1='eza -1'
fi

# bat for cat
alias cat='bat --style=plain --pager=never' 2>/dev/null

# cd aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ~='cd ~'

# kubectl aliases
alias k='kubectl'
alias kx='kubectx'

alias cm='chezmoi'
