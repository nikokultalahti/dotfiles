{{/*
   chezmoi config template.
   Rendered to ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.
   Re-run `chezmoi init` after editing to regenerate.
   https://www.chezmoi.io/docs/how-to/#re-create-your-config-file
*/ -}}

{{- $work := promptBoolOnce . "work" "Is this a work machine (y/n)" -}}

{{- $email := "hello@nikokultalahti.com" -}}
{{- if $work -}}
    {{- $email = promptStringOnce . "email" "Git email address for the author/committer" -}}
{{- end -}}

[bitwarden]
    unlock = "auto"
    # bw is installed via mise (run_once_before_1-install-prerequisites.sh.tmpl),
    # not a system package, so it's not guaranteed to be on chezmoi's own
    # PATH (a run_once_before_ script's PATH changes don't propagate back to
    # the chezmoi process itself). Point at mise's shim directly instead of
    # relying on PATH lookup.
    command = {{ printf "%s/.local/share/mise/shims/bw" .chezmoi.homeDir | quote }}

[data]
    work = {{ $work }}
    email = {{ $email | quote }}