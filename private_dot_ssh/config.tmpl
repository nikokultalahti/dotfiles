{{ if eq .chezmoi.os "darwin" }}
Host *
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
    IdentitiesOnly yes
{{ end }}

Host github.com
    HostName github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/github-auth.pub

{{ if ne .machine_type "work" }}
{{ (bitwarden "item" "Dotfiles - SSH Config - Personal").notes }}
{{ end }}

{{ if eq .machine_type "work" }}
{{ (bitwarden "item" "Dotfiles - SSH Config - Work").notes }}
{{ end }}