#!/bin/bash
# Runs after chezmoi apply, and changes the dotfiles repository origin to SSH

set -euo pipefail

# Logging functions
log() { printf '\033[1;34m[bootstrap]\033[0m %s\n' "$*"; }
error() { printf '\033[1;31m[bootstrap error]\033[0m %s\n' "$*" >&2; exit 1; }

repo_dir='{{ .chezmoi.sourceDir }}'
cd "$repo_dir"

url="$(git remote get-url origin 2>/dev/null || true)"

case "$url" in
  https://github.com/*)
    ssh_url="$(printf '%s\n' "$url" \
      | sed -E 's#^https://github\.com/([^/]+)/(.+)$#git@github.com:\1/\2#')"
    git remote set-url origin "$ssh_url"
    log "Switched origin to $ssh_url"
    ;;
  *)
    error "origin already uses SSH or is not a GitHub HTTPS URL: $url"
    ;;
esac